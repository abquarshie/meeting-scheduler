[database]
# Postgres connection string. Tables are created on first run.
url = "postgresql://user:password@host/dbname?sslmode=require"

# Copy this to .streamlit/secrets.toml for local use (it is git-ignored),
# or paste it into Streamlit Cloud → your app → Settings → Secrets.

# --- Sign-in -----------------------------------------------------------------
[auth]
password = "choose-a-shared-password"   # everyone types their name + this
                                         # (full access to everything)

# Or give each person their own account. Everyone still has full access to
# everything — participants, the workbook, settings, reports, both meetings —
# only the name recorded in the change log differs.
#
# [auth.users.Kofi]
# password = "first-password"
#
# [auth.users.Ama]
# password = "second-password"
