# File: secrets_toml.example

[database]
# Postgres connection string. Tables are created on first run.
url = "postgresql://user:password@host/dbname?sslmode=require"

# Copy this to .streamlit/secrets.toml for local use (it is git-ignored),
# or paste it into Streamlit Cloud → your app → Settings → Secrets.

# --- Sign-in -----------------------------------------------------------------
[auth]
# Everyone types their name + this shared password if you don't want per-user
# passwords. Leave it out when you list every user under [auth.users].
# password = "choose-a-shared-password"

# Per-user passwords (recommended once you use roles):
[auth.users]
Kofi = "kofi-password"
Yaw  = "yaw-password"

# Who does what. Keys must match [auth.users] (or the name typed at sign-in).
#   "overseer"    = Life and Ministry Overseer (midweek meeting)
#   "coordinator" = Talk Coordinator (weekend meeting)
# Anyone not listed here gets full access — the app stays backwards compatible.
[auth.roles]
Kofi = "overseer"
Yaw  = "coordinator"
