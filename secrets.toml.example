# Copy this to .streamlit/secrets.toml for local use (it is git-ignored),
# or paste it into Streamlit Cloud → your app → Settings → Secrets.

# --- Sign-in -----------------------------------------------------------------
[auth]
password = "choose-a-shared-password"   # everyone types their name + this

# Or give each person their own password (then the shared one is optional):
# [auth.users]
# Xan = "first-password"
# Kofi = "second-password"

# --- Google Sheets (keeps the data safe when the app restarts) ---------------
[gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR-SHEET-ID/edit"

# Paste the fields from the service-account JSON key file here.
[gcp_service_account]
type = "service_account"
project_id = "your-project"
private_key_id = "…"
private_key = "-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"
client_email = "meeting-scheduler@your-project.iam.gserviceaccount.com"
client_id = "…"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "…"
