# Neon: Connect -> pooled connection string (the same database the Streamlit app uses)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Any long random string. Signs the sign-in cookie; the Python function checks it too.
SESSION_SECRET="change-me-to-a-long-random-string"

# Sign-in, as in the Streamlit app's [auth] secrets: everyone types their name and this password...
APP_PASSWORD="choose-a-shared-password"
# ...or give people their own passwords (name=password, separated by semicolons). Everyone has full access;
# only the name in the change log differs.
# APP_USERS="Kofi=first-password;Ama=second-password"
